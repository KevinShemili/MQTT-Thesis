# SHARED CONFIGURATIONS
CACHE_DIRECTORY=disk-cache
TEMPERATURE_THRESHOLD=55
PAYLOAD_SIZES=16,64,256,1024,4096,16384,65536,262144,1048576
SYMMETRIC_KEY_SIZE=16
TIMING_DURATION=5
BASELINE_DURATION=10
WARMUP_DURATION=2
MEASUREMENT_DURATION=10
TAIL_DURATION=2

# SCENARIO 1: FULL SCHEMA
FULL_SCHEMA_RUNS=2
FULL_SCHEMA_ATTRIBUTE_COUNT=1
FULL_SCHEMA_RSA_KEY_BITS=3072
FULL_SCHEMA_RESULT_DIR=results/full_schema

# SCENARIO 2: CP-ABE VS. RSA
CPABE_RSA_RUNS=3
CPABE_RSA_ATTRIBUTE_COUNT=1,2,4,8,16,32
CPABE_RSA_SUBSCRIBER_COUNT=1,2,4,8,16,32,64
CPABE_RSA_RSA_KEY_SIZES=2048,3072,4096
CPABE_RSA_FIXED_RSA_KEY_SIZE=3072
CPABE_RSA_RESULT_DIR=results/cpabe_rsa

# SCENARIO 3: JSON vs. CBOR
JSON_CBOR_RUNS=8
JSON_CBOR_RESULT_DIR=results/json_cbor

# SCENARIO 4: AES vs. ASCON
AES_ASCON_RUNS=3
AES_ASCON_RESULT_DIR=results/aes_ascon

# ============================================================
# MICROBENCHMARK
# ============================================================

# SHARED CONFIGURATIONS
CACHE_DIRECTORY=disk-cache
TEMPERATURE_THRESHOLD=55
PAYLOAD_SIZES=16,64,256,1024,4096,16384,65536,262144,1048576
SYMMETRIC_KEY_SIZE=16
TIMING_DURATION=5
BASELINE_DURATION=10
# Energy: initial delay after launch, including startup, fixture loading and warmup.
WARMUP_DURATION=10
# UM24C samples are collected only during this interior window.
MEASUREMENT_DURATION=10
# Workload duration is WARMUP_DURATION + MEASUREMENT_DURATION + TAIL_DURATION.
TAIL_DURATION=2

# SCENARIO 1: AES vs. ASCON
AES_ASCON_RUNS=8
AES_ASCON_RESULT_DIR=results/aes_ascon

# SCENARIO 2: JSON vs. CBOR
JSON_CBOR_RUNS=8
JSON_CBOR_RESULT_DIR=results/json_cbor

# SCENARIO 3: CP-ABE vs. RSA
CPABE_RSA_RUNS=8
CPABE_RSA_ATTRIBUTE_COUNT=1,2,4,8,16,32
CPABE_RSA_SUBSCRIBER_COUNT=1,2,4,8,16,32,64
CPABE_RSA_RSA_KEY_SIZES=2048,3072,4096
CPABE_RSA_FIXED_RSA_KEY_SIZE=3072
CPABE_RSA_RESULT_DIR=results/cpabe_rsa

# SCENARIO 4: FULL SCHEMA
FULL_SCHEMA_RUNS=8
FULL_SCHEMA_PAYLOAD_SIZES=256,16384,1048576
FULL_SCHEMA_ATTRIBUTE_COUNT=1
FULL_SCHEMA_RSA_KEY_BITS=3072
FULL_SCHEMA_RESULT_DIR=results/full_schema


# ============================================================
# MACROBENCHMARK
# ============================================================

# Shared
MACRO_BROKER_URL=ssl://172.20.10.2:8883
MACRO_CA_CERTIFICATE=/home/thesis/MQTT-Thesis/environment/ca.crt
MACRO_BENCHMARK_TOPIC=mqtt-thesis/macro/data

MACRO_PAYLOAD_SIZES=256,16384,1048576
MACRO_MESSAGE_COUNT=10
MACRO_PUBLISH_INTERVAL_MILLISECONDS=5000
MACRO_RUNS=8
MACRO_WARMUP_RUNS=1
MACRO_RSA_KEY_BITS=3072
MACRO_ATTRIBUTE_COUNT=1

MACRO_PUBLISHER_SSH_TARGET=pi3
MACRO_SUBSCRIBER_SSH_TARGET=pi4

MACRO_RESULT_DIR=results/macro
MACRO_PUBLISHER_PROJECT_DIR=/home/thesis/MQTT-Thesis
MACRO_SUBSCRIBER_PROJECT_DIR=/home/thesis/MQTT-Thesis

# Publisher
MACRO_PUBLISHER_USERNAME=macro_publisher
MACRO_PUBLISHER_PASSWORD=1234
MACRO_PUBLISHER_CLIENT_ID=macro-publisher

# Subscriber
MACRO_SUBSCRIBER_USERNAME=macro_subscriber
MACRO_SUBSCRIBER_PASSWORD=5678
MACRO_SUBSCRIBER_CLIENT_ID=macro-subscriber
